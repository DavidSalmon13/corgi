# Copy to .env and adjust. Local development only: never put real credentials here.

# Postgres (docker-compose.yml and the API)
DATABASE_NAME=plainly
DATABASE_USER=plainly
DATABASE_PASSWORD=plainly
DATABASE_PORT=5432
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/plainly

# API
PORT=8080
# Optional fixed "today" (yyyy-MM-dd) for demos. Leave empty for the real date.
PLAINLY_TODAY=
