# Copy to .env and adjust. Local development only: never put real credentials here.

# Postgres (docker-compose.yml and the API)
DATABASE_NAME=plainly
DATABASE_USER=plainly
DATABASE_PASSWORD=plainly
DATABASE_PORT=5432
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/plainly

# API
PORT=8080
# Optional fixed "today" (yyyy-MM-dd) for demos. Leave empty for the real date.
PLAINLY_TODAY=

# Stripe, test mode only (sk_test_… / pk_test_…), from Developers → API keys in the Stripe dashboard.
# Leave empty to run with card payments switched off. The webhook secret is the whsec_… that
# `stripe listen --print-secret` shows (see README).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend sandbox, for the policy-issued email and payment/refund receipts. From resend.com → API Keys.
# Without a verified domain Resend only delivers to your own account's address, so every email goes to
# RESEND_TEST_TO (use the address you signed up to Resend with). Leave the key empty to switch emails off.
RESEND_API_KEY=
RESEND_FROM="Plainly <onboarding@resend.dev>"
RESEND_TEST_TO=
# Where the web app is served, for the links in emails.
PLAINLY_WEB_URL=http://localhost:5173
